<%- include('_userHeader.ejs') %>

<div class="container mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <h3>My Posts</h3>

    </div>

    <!-- Posts Grid -->
    <div class="row g-3">

        <% allPost.forEach(post => { %>

            <div class="col-md-4">

                <div class="card shadow-sm h-100">

                    <!-- Image -->
                    <img 
                        src="<%= post.dataValues.imageURL %>" 
                        class="card-img-top"
                        style="height: 200px; object-fit: cover;"
                    >

                    <!-- Content -->
                    <div class="card-body">

                        <h5 class="card-title">
                            <%= post.dataValues.title %>
                        </h5>

                        <p class="card-text text-muted">
                            <%= post.dataValues.description %>
                        </p>

                    </div>

                    <!-- Action -->
                    <div class="card-footer bg-white border-0">

                        <a 
                            href="/<%= username %>/<%= id %>/delete/<%= post.dataValues.id %>"
                            class="btn btn-danger w-100"
                        >
                            Delete Post
                        </a>

                    </div>

                </div>

            </div>

        <% }) %>

    </div>

</div>

<%- include('_userFooter.ejs') %>