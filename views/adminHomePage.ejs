<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<!-- Navbar -->
<nav class="navbar navbar-dark bg-dark px-3">
    <span class="navbar-brand">Admin Dashboard</span>

    <a href="/logout" class="btn btn-outline-light btn-sm">
        Logout
    </a>
</nav>

<div class="container mt-4">

    <h3 class="mb-4">All Users</h3>

    <div class="row g-3">

        <% users.forEach(user => { %>

            <div class="col-md-4">

                <div class="card shadow-sm h-100">

                    <!-- Profile Image -->
                    <img 
                        src="<%= user.dataValues.Profile.dataValues.reveralImageURL %>" 
                        class="card-img-top"
                        style="height: 200px; object-fit: cover;"
                    >

                    <div class="card-body">

                        <h5 class="card-title">
                            <%= user.dataValues.username %>
                        </h5>

                        <p class="card-text text-muted">
                            <%= user.dataValues.Profile.dataValues.reveralProfileDescription %>
                        </p>

                        <p class="small text-secondary">
                            ID: <%= user.dataValues.reveralId %>
                        </p>

                    </div>

                    <div class="card-footer bg-white border-0">

                        <a 
                            href="/<%= user.dataValues.reveralUsername %>/<%= user.dataValues.reveralId %>"
                            class="btn btn-primary w-100"
                        >
                            Open As Admin
                        </a>

                    </div>

                </div>

            </div>

        <% }) %>

    </div>

</div>

</body>
</html>