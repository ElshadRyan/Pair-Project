<%- include('_userHeader.ejs') %>

<div class="container mt-4">

    <!-- Page Title -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Find Friends</h3>
    </div>

    <!-- Search Box -->
    <form action="/<%= username %>/<%= id %>/add-friend" method="get" class="mb-4">
        <div class="input-group">
            <input 
                type="search" 
                name="search" 
                class="form-control"
                placeholder="Search users..."
            >
            <button class="btn btn-primary" type="submit">
                Search
            </button>
        </div>
    </form>

    <!-- User Cards -->
    <div class="row g-3">

        <% listAllUser.forEach(user => { %>

            <div class="col-md-4">

                <div class="card shadow-sm h-100">

                    <img 
                        src="<%= user.dataValues.Profile.dataValues.imageURL %>" 
                        class="card-img-top"
                        style="height: 200px; object-fit: cover;"
                    >

                    <div class="card-body">

                        <h5 class="card-title">
                            <%= user.dataValues.Profile.dataValues.name %>
                        </h5>

                        <p class="card-text text-muted">
                            <%= user.dataValues.Profile.dataValues.description %>
                        </p>

                        <p class="small text-secondary">
                            User ID: <%= user.dataValues.id %>
                        </p>

                    </div>

                    <div class="card-footer bg-white border-0">

                        <a 
                            href="/<%= username %>/<%= id %>/add-friend/add/<%= user.dataValues.id %>"
                            class="btn btn-success w-100"
                        >
                            + Add Friend
                        </a>

                    </div>

                </div>

            </div>

        <% }) %>

    </div>

</div>

<%- include('_userFooter.ejs') %>